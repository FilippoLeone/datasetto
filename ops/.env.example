# Copy to ops/.env. Values here feed docker-compose.yml and the app container.

# ---- public endpoint ------------------------------------------------------
# Domain for automatic HTTPS (Let's Encrypt). Use ":80" for plain HTTP (local or IP-only).
SITE_ADDRESS=datasetto.example.com
# Absolute site URL baked into SEO tags when building the web image locally (optional).
SITE_URL=https://datasetto.example.com

# ---- images ---------------------------------------------------------------
# Prebuilt by .github/workflows/images.yml. Pin IMAGE_TAG to a commit sha for reproducible deploys.
IMAGE_PREFIX=ghcr.io/filippoleone/datasetto
IMAGE_TAG=latest

# ---- app ------------------------------------------------------------------
CORS_ORIGINS=https://datasetto.example.com
# open | invite | closed  (invite is the sensible default for a friends-only server)
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=change-me
# Accounts with these emails always get the superuser role.
ADMIN_EMAILS=you@example.com
# Shown in the "stream with OBS" dialog. rtmps:// (port 1936) encrypts the stream key in
# transit using the site certificate; plain rtmp://datasetto.example.com/live (port 1935)
# stays available for machines on the server's own LAN.
PUBLIC_RTMP_URL=rtmps://datasetto.example.com:1936/live
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# ---- cost controls --------------------------------------------------------
# Viewers per live stream (every viewer costs the publisher's bitrate in egress).
STREAM_MAX_VIEWERS=10
# Publishers above this bitrate are dropped after two checks (15 s apart).
STREAM_MAX_BITRATE_KBPS=6000
# Estimated HLS egress per month after which streaming pauses until next month.
# Standard Tier egress on GCP includes 200 GiB free; keep this below it.
STREAM_MONTHLY_EGRESS_GB=150
# Optional: keeps viewer tickets valid across app restarts (any long random string).
HLS_TICKET_SECRET=
# VM-level backstop (ops/gcp/egress-guard.sh): throttle all egress above the soft
# limit and stop the stream/relay containers above the hard limit, per month.
EGRESS_SOFT_LIMIT_GB=190
EGRESS_HARD_LIMIT_GB=230

# ---- TURN relay (optional, enable with COMPOSE_PROFILES=turn) ---------------
# Needed only when some friends are behind strict NATs and voice fails to connect.
COMPOSE_PROFILES=
TURN_REALM=datasetto.example.com
TURN_SECRET=change-me-too
# Leave empty on GCP: the entrypoint reads the VM's public IP from the metadata server.
TURN_EXTERNAL_IP=
# Advertised to clients by the app (must match the VM's public hostname/IP and port).
TURN_URLS=turn:datasetto.example.com:3478
