# Copy to ops/.env. Values here feed docker-compose.yml and the app container.

# ---- public endpoint ------------------------------------------------------
# Domain for automatic HTTPS (Let's Encrypt). Use ":80" for plain HTTP (local or IP-only).
SITE_ADDRESS=datasetto.example.com
# Absolute site URL baked into SEO tags when building the web image locally (optional).
SITE_URL=https://datasetto.example.com

# ---- images ---------------------------------------------------------------
# Prebuilt by .github/workflows/images.yml. Pin IMAGE_TAG to a commit sha for reproducible deploys.
IMAGE_PREFIX=ghcr.io/filippoleone/datasetto
IMAGE_TAG=latest

# ---- app ------------------------------------------------------------------
CORS_ORIGINS=https://datasetto.example.com
# open | invite | closed  (invite is the sensible default for a friends-only server)
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=change-me
# Accounts with these emails always get the superuser role.
ADMIN_EMAILS=you@example.com
# Shown in the "stream with OBS" dialog. rtmps:// (port 1936) encrypts the stream key in
# transit using the site certificate; plain rtmp://datasetto.example.com/live (port 1935)
# stays available for machines on the server's own LAN.
PUBLIC_RTMP_URL=rtmps://datasetto.example.com:1936/live
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# ---- push notifications ------------------------------------------------------
# Web Push for browsers (direct messages and @mentions while the app is hidden).
# ops/vps/install.sh generates the key pair into this file on the server when both
# are empty and derives the subject from SITE_ADDRESS (or ADMIN_EMAILS). Keep the
# pair once made: browsers subscribe to the public key. To create one yourself:
#   docker run --rm node:24-slim npx -y web-push generate-vapid-keys
# Leave both keys empty to run without push notifications.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# mailto:you@example.com or https://datasetto.example.com (how push services reach you).
PUSH_VAPID_SUBJECT=

# ---- cost controls --------------------------------------------------------
# The defaults suit a metered cloud VM (GCP). 0 switches a limit off: on a VPS
# with unmetered traffic (OVH) set all three to 0; the stream key check, viewer
# tickets and the rate limits still apply.
# Viewers per live stream (every viewer costs the publisher's bitrate in egress).
STREAM_MAX_VIEWERS=10
# Publishers above this bitrate are dropped after two checks (15 s apart).
STREAM_MAX_BITRATE_KBPS=6000
# Estimated HLS egress per month after which streaming pauses until next month.
# GCP: Standard Tier egress includes 200 GiB free; keep this below it.
# Hetzner (20 TB per month): 15000 leaves room for the rest of the traffic.
STREAM_MONTHLY_EGRESS_GB=150
# Optional: keeps viewer tickets valid across app restarts (any long random string).
HLS_TICKET_SECRET=
# VM-level backstop (ops/common/egress-guard.sh): throttle all egress above the
# soft limit and stop the stream/relay containers above the hard limit, per month.
# Always on with the GCP startup script; on a VPS only with install.sh --egress-guard,
# where the defaults below would be far too low for an unmetered plan.
EGRESS_SOFT_LIMIT_GB=190
EGRESS_HARD_LIMIT_GB=230

# ---- backups (VPS) ----------------------------------------------------------
# ops/vps/backup.sh keeps 14 nightly SQLite copies in /var/backups/datasetto and,
# when this is set, also uploads them with rclone to this remote and path
# (configure the remote once with `rclone config` as root). Any rclone backend
# works: "b2:my-bucket/datasetto", "gdrive:datasetto-backups", "sftp-nas:backups".
# Leave empty to keep backups on the server only. Ignored on GCP (GCS bucket instead).
BACKUP_RCLONE_REMOTE=

# ---- TURN relay (optional, enable with COMPOSE_PROFILES=turn) ---------------
# Needed only when some friends are behind strict NATs and voice fails to connect.
COMPOSE_PROFILES=
TURN_REALM=datasetto.example.com
TURN_SECRET=change-me-too
# Leave empty on GCP: the entrypoint reads the VM's public IP from the metadata server.
# On a VPS set it to the server's public IPv4 (otherwise the entrypoint asks api.ipify.org).
TURN_EXTERNAL_IP=
# Advertised to clients by the app (must match the VM's public hostname/IP and port).
TURN_URLS=turn:datasetto.example.com:3478
# Relay caps, in BYTES per second (coturn's unit). The defaults keep a metered
# VM cheap: 1.5 MB/s (12 Mbit/s) per relayed session and 20 MB/s (160 Mbit/s)
# in total; the per-session cap softens relayed screen shares above 1080p60.
# On unmetered traffic set both to 0 (no bandwidth cap); the session quotas
# below stay as abuse protection.
TURN_MAX_BPS=1500000
TURN_BPS_CAPACITY=20000000
TURN_USER_QUOTA=6
TURN_TOTAL_QUOTA=40
