{
	admin off
}

# Docker's health probe. A plain-HTTP listener on a port that is not published:
# on the real site Caddy answers every request on :80 with a redirect to HTTPS,
# which the probe cannot follow, so it would report the container unhealthy.
:8081 {
	respond /healthz 200
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		-Server
	}

	# API, realtime socket and health live in the Node.js container.
	@backend path /api/* /socket.io/* /health
	handle @backend {
		reverse_proxy app:4000
	}

	# HLS playlists and segments are produced by nginx-rtmp. Every request is
	# checked with the app first: viewers need a signed ticket (header or cookie)
	# issued to a signed-in account, so a leaked stream URL serves nothing and
	# every byte of paid egress belongs to a known viewer.
	handle /hls/* {
		# route keeps the written order: answer CORS preflights first, then authorise.
		route {
			@preflight method OPTIONS
			header @preflight Access-Control-Allow-Origin "*"
			header @preflight Access-Control-Allow-Methods "GET, OPTIONS"
			header @preflight Access-Control-Allow-Headers "Origin, Range, Accept, Content-Type, X-Hls-Ticket"
			header @preflight Access-Control-Max-Age "600"
			respond @preflight 204
			forward_auth app:4000 {
				uri /internal/hls/auth
			}
			reverse_proxy rtmp:8080
		}
	}

	# Everything else is the static client.
	handle {
		root * /srv

		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"

		# One canonical URL per page: the landing page lives at /, the app at /app.
		redir /landing.html / permanent
		redir /index.html /app permanent
		redir /downloads /downloads.html permanent
		rewrite / /landing.html
		rewrite /app /index.html
		rewrite /app/* /index.html
		try_files {path} {path}.html /index.html
		file_server
	}
}
