{
  "name": "datasetto-desktop",
  "version": "0.1.8",
  "description": "Electron-based desktop shell for the Datasetto web client.",
  "private": true,
  "author": {
    "name": "Datasetto",
    "email": "noreply@datasetto.com"
  },
  "main": "main.js",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FilippoLeone/datasetto.git"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:electron\"",
    "dev:client": "npm run dev --prefix ../client",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "start": "cross-env NODE_ENV=production electron .",
    "start:local": "cross-env NODE_ENV=production DATASETTO_SERVER_URL=http://localhost:8080 electron .",
    "build": "npm run build:renderer && npm run prepare:renderer && node ./scripts/clean-release.mjs && electron-builder --publish never",
    "build:renderer": "cross-env VITE_BUILD_TARGET=desktop npm run build --prefix ../client",
    "prepare:renderer": "node ./scripts/copy-dist.mjs",
    "package": "npm run build",
    "release": "node ./scripts/build-release.mjs",
    "release:win": "node ./scripts/build-release.mjs --platform win",
    "release:linux": "node ./scripts/build-release.mjs --platform linux",
    "release:mac": "node ./scripts/build-release.mjs --platform mac",
    "release:all": "node ./scripts/build-release.mjs --platform all"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.datasetto.desktop",
    "productName": "Datasetto",
    "artifactName": "Datasetto-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "FilippoLeone",
      "repo": "datasetto",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json",
      "renderer/**/*",
      "picker/**/*",
      "overlay/**/*",
      "games/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Datasetto uses the microphone for voice channels.",
        "NSCameraUsageDescription": "Datasetto uses the camera for video in voice channels.",
        "NSAudioCaptureUsageDescription": "Datasetto captures system audio when you share your screen with sound."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "Datasetto-Portable-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
