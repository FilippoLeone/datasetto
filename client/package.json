    "hls.js": "^1.7.3",
    "lucide-preact": "^1.58.0",
    "preact": "^10.29.8",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.10.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
