# Only needed for the desktop/mobile builds, which must know the absolute server URL.
# The web build served by Caddy needs none of these.
VITE_SERVER_URL=https://your-domain.com
VITE_API_BASE_URL=https://your-domain.com
VITE_HLS_BASE_URL=https://your-domain.com/hls
VITE_RTMP_SERVER_URL=rtmps://your-domain.com:1936/live
# Absolute site URL for SEO tags (optional)
VITE_SITE_URL=https://your-domain.com
