# ---------------------------------------------------------------------------
# Datasetto server configuration
# Copy to .env for local development. In Docker, pass these as environment
# variables (see ops/.env.example). Every value has a sensible default except
# the ones marked REQUIRED.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
# Set to "true" when running behind Caddy/nginx so client IPs come from X-Forwarded-For
TRUST_PROXY=false

# SQLite database file. The directory is created on first start.
DATABASE_PATH=./data/datasetto.db
# Uploads (profile pictures) live under DATA_DIR/avatars. Defaults to the
# database's directory, which is the /data volume in Docker.
DATA_DIR=

# Public origins allowed to call the API / open sockets (comma separated).
# Native desktop/mobile shells (file://, capacitor://, http(s)://localhost) are
# always allowed unless ALLOW_NATIVE_ORIGINS=false.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_NATIVE_ORIGINS=true

# Public URLs shown to users (stream setup dialog, HLS playback). When empty the
# client derives them from the page origin, which is right for the Caddy setup.
PUBLIC_RTMP_URL=
PUBLIC_HLS_URL=

# Registration: open | invite | closed
REGISTRATION_MODE=open
# REQUIRED when REGISTRATION_MODE=invite. Share it with your friends, or hand out
# invite links (admin panel > Invites) which work next to this code.
REGISTRATION_INVITE_CODE=
# Comma separated emails that are always granted the superuser role.
ADMIN_EMAILS=

# Sessions
SESSION_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
# One active login per account: signing in on a new device (or tab) disconnects
# the previous connection with a "signed in elsewhere" notice. Set to false to
# allow the same account on several devices at once.
SINGLE_SESSION_PER_ACCOUNT=true

# Limits
MAX_CHANNELS=50
MAX_MESSAGE_LENGTH=2000
CHAT_HISTORY_LIMIT=100
MESSAGE_RETENTION_PER_CHANNEL=2000
MAX_MESSAGES_PER_MINUTE=30
MAX_CONNECTIONS_PER_IP=20

# TURN (coturn with use-auth-secret). Leave TURN_URLS empty to disable TURN.
# TURN_URLS example: turn:turn.example.com:3478
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=43200
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Streaming cost controls. RTMP_STAT_URL is the nginx-rtmp http server (stat +
# control endpoints); leave empty to disable the bitrate/budget watchdog.
RTMP_STAT_URL=
STREAM_MAX_VIEWERS=10
STREAM_MAX_BITRATE_KBPS=6000
STREAM_MONTHLY_EGRESS_GB=150
# Optional: keeps HLS viewer tickets valid across restarts.
HLS_TICKET_SECRET=

# The downloads page lists the latest release of this GitHub repository (owner/name),
# cached for RELEASES_CACHE_SECONDS.
RELEASES_GITHUB_REPO=FilippoLeone/datasetto
RELEASES_CACHE_SECONDS=600
